# Maintainer: Richard Seidt <r.seidt@gmail.com>
# Contributor: radxa

pkgname=qcom-va-driver
pkgver=1.1.1
pkgrel=1
pkgdesc='VA-API backend for Qualcomm Iris stateful V4L2 M2M decoding and H.264/HEVC encoding'
arch=('aarch64')
url='https://github.com/radxa-pkg/qcom-va-driver'
provides=("libva-v4l2=$pkgver")
conflicts=('libva-v4l2')
replaces=('libva-v4l2')
license=('MIT' 'GPL-2.0-only')
depends=(
    'gcc-libs'
    'glibc'
    'libbsd'
    'libdrm'
    'libglvnd'
    'libva'
    'libyaml'
    'mesa'
    'vulkan-freedreno'
    'vulkan-icd-loader'
)
makedepends=(
    'ghc'
    'git'
    'glslang'
    'haskell-syb'
    'meson'
    'ninja'
    'vulkan-headers'
)
# Native strip cannot process the Hexagon DSP skeleton.
options=('!strip')
source=("$pkgname::git+https://github.com/radxa-pkg/qcom-va-driver.git#tag=v$pkgver")
sha256sums=('690114f9bb56053c25e9311a054280b1d2abc60305a3bc9cdd5500b880c6707e')

prepare() {
    cd "$pkgname"
    meson subprojects download qaic hexagon fastrpc
}

build() {
    rm -rf build
    arch-meson "$pkgname" build \
        -Dgpu_copy=enabled \
        -Dcdsp_vpp=enabled \
        -Dfastrpc=bundled \
        -Dvulkan_vpp=enabled
    meson compile -C build
}

package() {
    DESTDIR="$pkgdir" meson install -C build --no-rebuild
    install -d "$pkgdir/usr/share/doc/$pkgname"
    cp -a "$pkgname/patches" "$pkgdir/usr/share/doc/$pkgname/"

    # Enable and prefer GStreamer VA elements in user sessions and login shells.
    local feature_rank='vah264dec:1000,vah264enc:1000,vah265dec:1000,vah265enc:1000,vavp9dec:1000'
    install -d "$pkgdir/usr/lib/environment.d" "$pkgdir/etc/profile.d"
    printf '%s\n' 'GST_VA_ALL_DRIVERS=1' \
        "GST_PLUGIN_FEATURE_RANK=$feature_rank" \
        > "$pkgdir/usr/lib/environment.d/60-libva-v4l2.conf"
    printf '%s\n' 'export GST_VA_ALL_DRIVERS=1' \
        "export GST_PLUGIN_FEATURE_RANK=$feature_rank" \
        > "$pkgdir/etc/profile.d/libva-v4l2.sh"
    chmod 644 "$pkgdir/usr/lib/environment.d/60-libva-v4l2.conf" \
        "$pkgdir/etc/profile.d/libva-v4l2.sh"
}
